data <- read.csv("~/Individualistic/identity_study/DGF_Coding_Spreadsheet - Summary.csv", skip = 4, header = TRUE)
# Step 2: Add the corrected DGI column
data <- data %>%
mutate(DGI_correct = A_avg + B_avg + D_avg - C_avg)
# Step 3: Check known row (target: DGI_correct should be 8; old DGI is the broken value)
cat("=== ROW CHECK (target DGI_correct = 8) ===\n")
data %>%
filter(response_id == "D-C1_ChatGPT") %>%
select(A_avg, B_avg, C_avg, D_avg, DGI, DGI_correct) %>%
print()
# Step 4: How many rows differ between old DGI and DGI_correct
cat("\n=== NUMBER OF ROWS WHERE OLD DGI != DGI_correct ===\n")
data %>%
summarise(n_different = sum(DGI != DGI_correct)) %>%
print()
# Step 5: Re-run ANOVAs on DGI_correct
cat("\n=== MODEL ANOVA (target: F=1.258, df=2,117, p=.288, eta2=.02) ===\n")
model_anova <- aov(DGI_correct ~ model, data = data)
print(summary(model_anova))
print(eta_squared(model_anova))
cat("\n=== STATUS ANOVA (target: F=24.11, df=3,116, p<.001, eta2=.38) ===\n")
status_anova <- aov(DGI_correct ~ identity_status, data = data)
print(summary(status_anova))
print(eta_squared(status_anova))
# Step 6: Group means
cat("\n=== MODEL MEANS (target: ChatGPT 7.40, Gemini 7.25, Claude 6.83) ===\n")
data %>% group_by(model) %>% summarise(mean_DGI = mean(DGI_correct), sd_DGI = sd(DGI_correct)) %>% print()
cat("\n=== STATUS MEANS (target: Moratorium 8.20, Diffusion 8.00, Foreclosure 6.83, Achievement 5.60) ===\n")
data %>% group_by(identity_status) %>% summarise(mean_DGI = mean(DGI_correct), sd_DGI = sd(DGI_correct)) %>% print()
# Step 7: Welch's versions
cat("\n=== WELCH MODEL (target: F=1.14, p=.327) ===\n")
print(oneway.test(DGI_correct ~ model, data = data))
cat("\n=== WELCH STATUS (target: F=20.74, p<.001) ===\n")
print(oneway.test(DGI_correct ~ identity_status, data = data))
# Step 8: Bartlett's tests
cat("\n=== BARTLETT MODEL (target: p=.253) ===\n")
print(bartlett.test(DGI_correct ~ model, data = data))
cat("\n=== BARTLETT STATUS (target: p<.001) ===\n")
print(bartlett.test(DGI_correct ~ identity_status, data = data))
# Step 9: Holm-corrected pairwise
cat("\n=== PAIRWISE STATUS (target: all pairs sig except Diffusion-Moratorium p=.402) ===\n")
print(pairwise.t.test(dataDGIcorrect,dataidentity_status, pool.sd = FALSE, p.adjust.method = "holm"))
with(data, pairwise.t.test(DGI_correct, identity_status, pool.sd = FALSE, p.adjust.method = "holm")))
with(data, pairwise.t.test(DGI_correct, identity_status, pool.sd = FALSE, p.adjust.method = "holm")))
with(data, pairwise.t.test(DGI_correct, identity_status, pool.sd = FALSE, p.adjust.method = "holm"))
cat("\n=== WELCH STATUS (target: F=20.74, p<.001) ===\n")
print(oneway.test(DGI_correct ~ identity_status, data = data))
# Step 8: Bartlett's tests
cat("\n=== BARTLETT MODEL (target: p=.253) ===\n")
print(bartlett.test(DGI_correct ~ model, data = data))
cat("\n=== BARTLETT STATUS (target: p<.001) ===\n")
print(bartlett.test(DGI_correct ~ identity_status, data = data))
# Step 9: Holm-corrected pairwise
cat("\n=== PAIRWISE STATUS (target: all pairs sig except Diffusion-Moratorium p=.402) ===\n")
