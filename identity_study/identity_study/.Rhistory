# ===== FULL CORRECTED SCRIPT: ANALYSIS + FIGURES =====
rm(list = ls())
library(dplyr)
library(ggplot2)
library(effectsize)
# Step 1: Load fresh from file
data <- read.csv("~/Individualistic/identity_study/DGF_Coding_Spreadsheet - Summary.csv", skip = 4, header = TRUE)
# Step 2: Set factor levels for correct plotting order
data <- data %>%
mutate(
model = factor(model, levels = c("ChatGPT", "Claude", "Gemini")),
identity_status = factor(identity_status, levels = c("Diffusion", "Foreclosure", "Moratorium", "Achievement"))
)
# Step 3: Compute the CORRECT DGI (this is what your Results section is based on)
data <- data %>%
mutate(DGI_correct = A_avg + B_avg + D_avg - C_avg)
# Step 4: Sanity check (target: DGI_correct = 8 for this row)
cat("=== ROW CHECK (target DGI_correct = 8) ===\n")
data %>%
filter(response_id == "D-C1_ChatGPT") %>%
select(A_avg, B_avg, C_avg, D_avg, DGI, DGI_correct) %>%
print()
cat("\n=== MODEL ANOVA (target: F=1.258, df=2,117, p=.288, eta2=.02) ===\n")
model_anova <- aov(DGI_correct ~ model, data = data)
print(summary(model_anova))
print(eta_squared(model_anova))
cat("\n=== STATUS ANOVA (target: F=24.11, df=3,116, p<.001, eta2=.38) ===\n")
status_anova <- aov(DGI_correct ~ identity_status, data = data)
print(summary(status_anova))
print(eta_squared(status_anova))
cat("\n=== MODEL MEANS (target: ChatGPT 7.40, Gemini 7.25, Claude 6.83) ===\n")
data %>% group_by(model) %>% summarise(mean_DGI = mean(DGI_correct), sd_DGI = sd(DGI_correct)) %>% print()
cat("\n=== STATUS MEANS (target: Diffusion 8.00, Foreclosure 6.83, Moratorium 8.20, Achievement 5.60) ===\n")
data %>% group_by(identity_status) %>% summarise(mean_DGI = mean(DGI_correct), sd_DGI = sd(DGI_correct)) %>% print()
cat("\n=== WELCH MODEL (target: F=1.14, p=.327) ===\n")
print(oneway.test(DGI_correct ~ model, data = data))
cat("\n=== WELCH STATUS (target: F=20.74, p<.001) ===\n")
print(oneway.test(DGI_correct ~ identity_status, data = data))
cat("\n=== BARTLETT MODEL (target: p=.253) ===\n")
print(bartlett.test(DGI_correct ~ model, data = data))
cat("\n=== BARTLETT STATUS (target: p<.001) ===\n")
print(bartlett.test(DGI_correct ~ identity_status, data = data))
cat("\n=== PAIRWISE STATUS (target: all sig except Diffusion-Moratorium p=.402) ===\n")
print(pairwise.t.test(dataDGIcorrect,dataidentity_status, pool.sd = FALSE, p.adjust.method = "holm"))
cat("\n=== PREMATURE COMMITMENT (C) BY STATUS (target: F=17.24, p<.001) ===\n")
print(oneway.test(C_avg ~ identity_status, data = data))
cat("\n=== EMOTIONAL VALIDATION (A) BY MODEL (target: F=4.61, p=.013) ===\n")
print(oneway.test(A_avg ~ model, data = data))
cat("\n=== EXPLORATORY ENCOURAGEMENT (B) BY MODEL (target: F=1.32, p=.272) ===\n")
print(oneway.test(B_avg ~ model, data = data))
cat("\n=== EXPLORATORY ENCOURAGEMENT (B) BY STATUS (target: F=9.89, p<.001) ===\n")
print(oneway.test(B_avg ~ identity_status, data = data))
# Figure 1: Mean DGI by Model
model_summary <- data %>%
group_by(model) %>%
summarise(mean_DGI = mean(DGI_correct), se = sd(DGI_correct) / sqrt(n()))
ggplot(model_summary, aes(x = model, y = mean_DGI, fill = model)) +
geom_col(width = 0.5, show.legend = FALSE) +
geom_errorbar(aes(ymin = mean_DGI - 1.96 * se, ymax = mean_DGI + 1.96 * se), width = 0.2) +
labs(title = "Mean DGI by AI Model", x = "AI Model", y = "Mean DGI (95% CI)") +
theme_classic()
ggsave("figure1_model_DGI.png", dpi = 300, width = 7, height = 6)
# Figure 2: Mean DGI by Identity Status
status_summary <- data %>%
group_by(identity_status) %>%
summarise(mean_DGI = mean(DGI_correct), se = sd(DGI_correct) / sqrt(n()))
ggplot(status_summary, aes(x = identity_status, y = mean_DGI, fill = identity_status)) +
geom_col(width = 0.5, show.legend = FALSE) +
geom_errorbar(aes(ymin = mean_DGI - 1.96 * se, ymax = mean_DGI + 1.96 * se), width = 0.2) +
labs(title = "Mean DGI by Identity Status", x = "Identity Status", y = "Mean DGI (95% CI)") +
theme_classic()
ggsave("figure2_status_DGI.png", dpi = 300, width = 7, height = 6)
cat("\n=== DONE — figure1_model_DGI.png and figure2_status_DGI.png regenerated from DGI_correct ===\n")
cat("Sanity check on saved figures: Diffusion and Moratorium bars should now be the TALLEST (both ~8), Achievement the SHORTEST (~5.6). Claude's bar should be visibly lower than ChatGPT/Gemini.\n")
